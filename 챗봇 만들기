        "    while start < len(text):\n",
        "        chunk = text[start:start + chunk_size]\n",
        "        if chunk.strip():\n",
        "            chunks.append(chunk)\n",
        "        start += chunk_size - overlap\n",
        "    return chunks\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. 캐릭터/엔티티 단위 청킹 (nikke_characters 맞춤)\n",
        "# --------------------------------------------------\n",
        "def chunk_by_character(text: str, max_len: int = 800) -> list[str]:\n",
        "    \"\"\"\n",
        "    줄바꿈 또는 캐릭터 나눔 패턴을 기준으로 청킹\n",
        "    긴 캐릭터 설명은 고정 크기로 2차 청킹\n",
        "    \"\"\"\n",
        "    # 캐릭터명이나 섹션 구분자 기준 분할 (필요 시 패턴 수정)\n",
        "    blocks = [b.strip() for b in re.split(r\"\\n(?=[A-Z가-힣0-9_]+\\s*[:\\-\\=\\|])|\\n{2,}\", text) if b.strip()]\n",
        "\n",
        "    chunks = []\n",
        "    for block in blocks:\n",
        "        if len(block) <= max_len:\n",
        "            chunks.append(block)\n",
        "        else:\n",
        "            # 긴 블록은 분할\n",
        "            for p in chunk_text(block, max_len, 100):\n",
        "                chunks.append(p)\n",
        "    return chunks\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. 노이즈 검증 함수 (게임 데이터용)\n",
