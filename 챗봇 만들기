        "def search_vectordb(query: str, strategy_name: str = \"fixed_500\", top_k: int = 3):\n",
        "    \"\"\"\n",
        "    선택한 전략(컬렉션)에서 질문과 유사한 청크 검색\n",
        "    cosine 공간이므로 유사도 = 1 - distance\n",
        "    \"\"\"\n",
        "    col = client.get_collection(strategy_name)\n",
        "    q_emb = embed_texts([query])[0].tolist()\n",
        "\n",
        "    res = col.query(\n",
        "        query_embeddings=[q_emb],\n",
        "        n_results=top_k\n",
        "    )\n",
        "\n",
        "    return [\n",
        "        {\"id\": i, \"text\": t, \"metadata\": m, \"similarity\": 1 - d}\n",
        "        for i, t, m, d in zip(res[\"ids\"][0], res[\"documents\"][0], res[\"metadatas\"][0], res[\"distances\"][0])\n",
        "    ]\n",
        "\n",
        "def show_search(query: str, strategy_name: str = \"fixed_500\", top_k: int = 3):\n",
        "    print(f\"=== 질문: '{query}' (전략: {strategy_name}) ===\")\n",
        "    results = search_vectordb(query, strategy_name=strategy_name, top_k=top_k)\n",
        "\n",
        "    for rank, r in enumerate(results, 1):\n",
        "        m = r[\"metadata\"]\n",
        "        print(f\"\\n[{rank}위] 유사도 {r['similarity']:.4f} | 청크 인덱스: {m.get('chunk_index', 'N/A')}\")\n",
        "        print(r[\"text\"][:200] + (\"...\" if len(r[\"text\"]) > 200 else \"\"))\n",
        "\n",
        "# 검색 테스트 (니케 캐릭터 관련 질문 예시)\n",
        "show_search(\"홍련 스킬 정보 알려줘\", strategy_name=\"fixed_500\")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60 + \"\\n\")\n",
        "\n",
        "show_search(\"홍련 스킬 정보 알려줘\", strategy_name=\"entity_char\")"
