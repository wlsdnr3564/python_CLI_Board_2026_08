        "# 1. 전략별 임베딩 벡터 사전 준비 (이미 캐시 처리됨)\n",
        "strategy_vecs = {name: embed_cached(name, chunks) for name, chunks in strategies.items()}\n",
        "\n",
        "def compare_chunking(query: str, top_k: int = 3):\n",
        "    print(f\"==================== 질문: '{query}' ====================\")\n",
        "    q = embed_texts([query])[0]\n",
        "\n",
        "    for name, chunks in strategies.items():\n",
        "        if not chunks:\n",
        "            continue\n",
        "\n",
        "        scores = strategy_vecs[name] @ q\n",
        "        print(f\"\\n▶ 전략 [ {name} ]\")\n",
        "\n",
        "        top_indices = np.argsort(scores)[::-1][:top_k]\n",
        "        for rank, i in enumerate(top_indices, 1):\n",
        "            c = chunks[i]\n",
        "            noises = noise_tags(c)\n",
        "            noise_str = ', '.join(noises) if noises else '없음'\n",
        "\n",
        "            preview = re.sub(r\"\\s+\", \" \", c).strip()\n",
        "            print(f\"  [{rank}위] 유사도: {scores[i]:.4f} | 노이즈: {noise_str}\")\n",
        "            print(\"        \" + preview[:120] + (\"...\" if len(preview) > 120 else \"\"))\n",
        "\n",
        "# 게임 캐릭터/스킬 데이터 검색 테스트\n",
