        "from sklearn.decomposition import PCA\n",
        "import plotly.express as px\n",
        "import plotly.graph_objects as go\n",
        "import re\n",
        "import numpy as np\n",
        "\n",
        "def plot_embeddings_3d(query: str | None = None, strategy_name: str = \"fixed_500\", top_k: int = 5):\n",
        "\n",
        "    chunks = strategies.get(strategy_name, [])\n",
        "    if not chunks:\n",
        "        print(f\"전략 '{strategy_name}'에 해당하는 청크가 없습니다.\")\n",
        "        return\n",
        "\n",
        "    # 1. 임베딩 가져오기 및 PCA 차원 축소 (3D)\n",
        "    vecs = strategy_vecs[strategy_name]\n",
        "    pca = PCA(n_components=3)\n",
        "    vis = pca.fit_transform(vecs)\n",
        "    ratio = pca.explained_variance_ratio_.sum()\n",
        "\n",
        "    # 2. 시각화용 데이터프레임 구성\n",
        "    df = {\n",
        "        \"x\": vis[:, 0], \"y\": vis[:, 1], \"z\": vis[:, 2],\n",
        "        \"chunk_id\": [f\"Chunk_{i}\" for i in range(len(chunks))],\n",
        "        \"preview\": [re.sub(r\"\\s+\", \" \", c)[:60] for c in chunks],\n",
        "    }\n",
        "\n",
        "    fig = px.scatter_3d(\n",
        "        df, x=\"x\", y=\"y\", z=\"z\",\n",
        "        hover_name=\"chunk_id\",\n",
        "        hover_data={\"preview\": True, \"x\": False, \"y\": False, \"z\": False},\n",
        "        color_discrete_sequence=px.colors.qualitative.Alphabet,\n",
        "        title=f\"니케 데이터 임베딩 3D 시각화 (전략: {strategy_name}, PCA 설명력 {ratio:.1%})\",\n",
        "    )\n",
        "    fig.update_traces(marker=dict(size=4, opacity=0.7, color=\"#1f77b4\"))\n",
        "\n",
        "    # 3. 질문(Query) 및 Top-K 검색 결과 하이라이트\n",
        "    if query:\n",
        "        # 질문 임베딩 생성 및 동일한 PCA 공간으로 변환\n",
        "        q_emb = embed_texts([query])[0]\n",
        "        q_pca = pca.transform([q_emb])[0]\n",
        "\n",
        "        # 검색 수행 (유사도 상위 indices)\n",
        "        scores = vecs @ q_emb\n",
        "        top_indices = np.argsort(scores)[::-1][:top_k]\n",
        "\n",
        "        # Top-K 하이라이트 표시\n",
        "        fig.add_trace(go.Scatter3d(\n",
        "            x=vis[top_indices, 0], y=vis[top_indices, 1], z=vis[top_indices, 2],\n",
        "            mode=\"markers+text\",\n",
        "            name=f\"검색 Top-{top_k}\",\n",
        "            text=[f\"{n}위\" for n in range(1, len(top_indices) + 1)],\n",
        "            hovertext=[re.sub(r\"\\s+\", \" \", chunks[i])[:60] for i in top_indices],\n",
        "            marker=dict(size=8, color=\"rgba(0,0,0,0)\", line=dict(color=\"orange\", width=3)),\n",
        "        ))\n",
        "\n",
        "        # 질문 위치(Q) 표시\n",
        "        fig.add_trace(go.Scatter3d(\n",
        "            x=[q_pca[0]], y=[q_pca[1]], z=[q_pca[2]],\n",
        "            mode=\"markers+text\", name=\"질문 (Q)\",\n",
        "            text=[\"Q\"], hovertext=[query],\n",
        "            marker=dict(size=12, color=\"red\", symbol=\"diamond\"),\n",
        "        ))\n",
        "\n",
        "        # 질문과 Top-K 지점 연결선 그리기\n",
        "        for p in top_indices:\n",
        "            fig.add_trace(go.Scatter3d(\n",
        "                x=[q_pca[0], vis[p, 0]], y=[q_pca[1], vis[p, 1]], z=[q_pca[2], vis[p, 2]],\n",
        "                mode=\"lines\",\n",
        "                line=dict(color=\"red\", width=2, dash=\"dash\"),\n",
        "                showlegend=False, hoverinfo=\"skip\",\n",
        "            ))\n",
        "\n",
        "    fig.update_layout(height=750, legend=dict(itemsizing=\"constant\"))\n",
        "    fig.show()\n",
        "\n",
