      "source": [
        "from openai import OpenAI\n",
        "import tiktoken\n",
        "from google.colab import userdata\n",
        "\n",
        "\n",
        "# 문제 0 - 가상 규칙 데이터\n",
        "rules = [\n",
        "    \"루미나 길드의 모든 회원은 매주 월요일 오후 9시까지 주간 임무를 3회 이상 완료해야 한다.\",\n",
        "    \"루미나 길드의 신규 회원은 가입 후 7일 동안 실버 등급으로 유지된다.\",\n",
        "    \"아르카디아 광장에서 열리는 길드 회의에는 최소 5명의 회원이 참석해야 한다.\",\n",
        "    \"길드 창고에서 하루에 가져갈 수 있는 회복 물약은 회원당 최대 4개이다.\",\n",
        "    \"루미나 길드의 공동 자금을 사용할 때는 10000골드 이상이면 간부 2명의 승인을 받아야 한다.\",\n",
        "    \"회원이 길드원에게 고의로 피해를 주면 첫 번째 위반 시 24시간 동안 길드 활동이 제한된다.\",\n",
        "    \"같은 회원이 규칙을 3회 위반하면 루미나 길드에서 자동으로 추방된다.\",\n",
        "    \"매주 토요일 오후 8시에 시작되는 보스 토벌에는 골드 등급 이상 회원만 참여할 수 있다.\",\n",
        "    \"보스 토벌에서 획득한 전설 등급 아이템은 기여도 점수가 가장 높은 3명에게 우선 분배된다.\",\n",
        "    \"길드장 세리아가 14일 이상 접속하지 않으면 부길드장 카일이 임시 길드장 권한을 가진다.\"\n",
        "]\n",
        "\n",
        "\n",
        "encoding = tiktoken.encoding_for_model(\"gpt-4o-mini\")\n",
        "\n",
        "client = OpenAI(\n",
        "    api_key=userdata.get(\"OPENAI_API_KEY\")\n",
        ")\n",
        "\n",
        "rules_text = \"\\n\".join(rules)\n",
        "\n",
        "conversation_history = [\n",
        "    {\n",
        "        \"role\": \"system\",\n",
        "        \"content\": f\"너는 정보가 없는 내용을 들으면 \\\"자료에 없습니다\\\"라고 답해야해.\"\n",
        "        \"루미나 길드의 모든 회원은 매주 월요일 오후 9시까지 주간 임무를 3회 이상 완료해야 한다.\"\n",
        "        \"루미나 길드의 신규 회원은 가입 후 7일 동안 실버 등급으로 유지된다.\"\n",
        "        \"아르카디아 광장에서 열리는 길드 회의에는 최소 5명의 회원이 참석해야 한다.\"\n",
        "        \"길드 창고에서 하루에 가져갈 수 있는 회복 물약은 회원당 최대 4개이다.\"\n",
        "        \"루미나 길드의 공동 자금을 사용할 때는 10000골드 이상이면 간부 2명의 승인을 받아야 한다.\"\n",
        "        \"회원이 길드원에게 고의로 피해를 주면 첫 번째 위반 시 24시간 동안 길드 활동이 제한된다.\"\n",
        "        \"같은 회원이 규칙을 3회 위반하면 루미나 길드에서 자동으로 추방된다.\"\n",
        "        \"매주 토요일 오후 8시에 시작되는 보스 토벌에는 골드 등급 이상 회원만 참여할 수 있다.\"\n",
        "        \"보스 토벌에서 획득한 전설 등급 아이템은 기여도 점수가 가장 높은 3명에게 우선 분배된다.\"\n",
        "        \"길드장 세리아가 14일 이상 접속하지 않으면 부길드장 카일이 임시 길드장 권한을 가진다.\"\n",
        "\n",
        "\n",
        "        }\n",
        "]\n",
        "\n",
        "def summation():\n",
        "\n",
        "    # system + user + assistant가 최소한 있어야 함\n",
        "    if len(conversation_history) < 3:\n",
        "        return\n",
        "\n",
        "    # 가장 오래된 user + assistant 대화\n",
        "    old_messages = conversation_history[1:3]\n",
        "\n",
        "    text = \"\"\n",
        "\n",
        "    for message in old_messages:\n",
        "        text += f\"{message['role']} : {message['content']}\\n\"\n",
        "\n",
        "    # 요약 요청\n",
        "    response = client.chat.completions.create(\n",
        "        model=\"gpt-4o-mini\",\n",
        "        messages=[{\"role\": \"system\",\"content\": \"\"\"다음 대화를 짧게 요약해라.\"\"\"},{\"role\": \"user\",\"content\": text}])\n",
        "\n",
        "    summary = response.choices[0].message.content\n",
        "    del conversation_history[1:3]\n",
        "\n",
        "    conversation_history.insert(\n",
        "      1,\n",
        "      {\n",
        "          \"role\": \"assistant\",\n",
        "          \"content\": f\"[이전 대화 요약]\\n{summary}\"\n",
        "      }\n",
        "    )\n",
        "    print(\"대화 요약\")\n",
        "    print(summary)\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "def chat(user_message):\n",
        "  #나의 대화를 저장\n",
        "  conversation_history.append({\"role\" : \"user\", \"content\" : user_message})\n",
        "\n",
        "  response = client.chat.completions.create(\n",
        "      model='gpt-4o-mini',\n",
        "      messages= conversation_history\n",
        "  )\n",
        "\n",
        "  assistant_message = response.choices[0].message.content\n",
        "\n",
        "  #ai가 한 대화를 여기서 저장\n",
        "  conversation_history.append({\"role\" : \"assistant\", \"content\" : assistant_message})\n",
        "\n",
        "  token_count = sum(len(encoding.encode(message[\"content\"])) for message in conversation_history\n",
        "    )\n",
        "  print(f\"토큰 수 : {token_count}개\")\n",
        "\n",
        "  if token_count > 500:\n",
        "    # 토큰의 양이 500이 넘으면 user, assistant 내용이 요약\n",
        "    summation\n",
        "\n",
        "  return assistant_message\n",
        "\n",
        "while True:\n",
        "\n",
        "    question = input(\"사용자 : \")\n",
        "\n",
        "    if question == \"quit\":\n",
        "        break\n",
        "\n",
        "    print(f\"모델 : {chat(question)}\")"
      ]
    }
  ]
